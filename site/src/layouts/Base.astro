---
import '../styles/paper.css';
import '../styles/site.css';
import Subscribe from '../components/Subscribe.astro';

interface Props { title: string; description?: string; current?: string }
const { title, description = '', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 導覽七項，刻意比 arkiv 少兩項（它另有「案例」與「回饋」）。
// 「誠實清單」沿用 arkiv 的那一頁 —— 它是本專案最有內容的一頁，
// 因為 reel-scout 的已知限制是實際踩出來的，不是想像的。
const nav = [
  { id: 'home',         href: `${base}/`,                 label: '首頁' },
  { id: 'how-it-works', href: `${base}/how-it-works.html`, label: '運作方式' },
  { id: 'demo',         href: `${base}/demo.html`,         label: '實際畫面' },
  { id: 'limits',       href: `${base}/limits.html`,       label: '誠實清單' },
  { id: 'install',      href: `${base}/install.html`,      label: '安裝' },
  { id: 'docs',         href: `${base}/docs.html`,         label: '文件' },
  { id: 'changelog',    href: `${base}/changelog.html`,    label: '更新紀錄' },
];
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google tag (gtag.js) — 與 arkiv 官網、wafflehouse.com.tw 共用同一個 Google Tag，
     供跨站歸因比對。三站同一個 tag 的理由：同一篇文章／同一份課程教材會同時連出去
     兩支工具，分開的 tag 量不到「他是先看了哪一邊才過來的」。 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=GT-WB2F3LB8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'GT-WB2F3LB8');
</script>
<title>{title}</title>
{description && <meta name="description" content={description}>}
<slot name="head" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect width=%2764%27 height=%2764%27 fill=%27%23f1efe9%27/%3E%3Crect x=%278%27 y=%2718%27 width=%2748%27 height=%2728%27 fill=%27none%27 stroke=%27%23231916%27 stroke-width=%274%27/%3E%3Ccircle cx=%2724%27 cy=%2732%27 r=%275%27 fill=%27%23231916%27/%3E%3Ccircle cx=%2740%27 cy=%2732%27 r=%275%27 fill=%27%23231916%27/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
<nav class="topnav" aria-label="主要導覽">
  <div class="topnav-in">
    <a class="topnav-mark" href={`${base}/`}>reel&#8203;scout</a>
    <ul>
      {nav.map((n) => <li><a href={n.href} aria-current={n.id === current ? 'page' : undefined}>{n.label}</a></li>)}
      <li><a href="https://github.com/vulture-s/reel-scout">GitHub</a></li>
    </ul>
  </div>
</nav>
<slot />
<footer>
  <div class="wrap">
    <Subscribe />
    <div class="foot-links">
      <a href="https://github.com/vulture-s/reel-scout">GitHub</a>
      <a href="https://pypi.org/project/reel-scout/">PyPI</a>
      <a href={`${base}/install.html`}>安裝</a>
      <a href={`${base}/docs.html`}>文件</a>
      <a href={`${base}/limits.html`}>誠實清單</a>
      <a href={`${base}/changelog.html`}>更新紀錄</a>
      <a href="https://github.com/vulture-s/reel-scout/blob/master/LICENSE">授權（MIT）</a>
      <a href="https://vulture-s.github.io/arkiv/">arkiv</a>
      <a href="https://www.instagram.com/vulture.s/">@vulture.s</a>
    </div>
    <p>
      MIT License · Hevin Yeh (vulture.s)<br>
      本機優先：轉錄與視覺分析跑在你自己的機器上，素材與逐字稿不會被送到我們這裡（本頁使用 Google Analytics）
    </p>
  </div>
</footer>
</body>
</html>
