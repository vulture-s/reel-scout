---
// 首頁的工藝評分面板 —— **可以真的拖**的重新加權，不是截圖也不是示意。
//
// 為什麼這一塊要能互動：「重新加權」是這個工具少見的功能，而它的主張是
// 「分數不是判決，它取決於你重視什麼」—— 那件事**沒辦法用靜態畫面演示**。
// 讀者拖一下、看到總分跟著動，比任何一句話都快。
//
// 🔴 數學逐行照 `reel_scout/inspector.py` 的 `computeOverall`（它自己又對齊
// `ingest.normalize_weights` / `compute_overall`）：負值夾到 0 → 重新縮放到總和 1
// → 加權和 → 四捨五入到小數兩位。**不自己發明一套** —— 官網算出來的數字如果跟
// CLI 不一樣，那比沒有這個面板更糟。
// 預設權重取自 `config.SCORE_WEIGHTS`：30 / 25 / 20 / 25。
// 驗算：6.5×.30 + 7.0×.25 + 6.0×.20 + 7.5×.25 = 6.775 → 6.78，與 DB 的 overall 一致。
//
// 🔴 數字是**語料裡真的那一支**（`02d06d93185562b2`，2026-10-01 由
// ollama:qwen2.5:14b 評的）。官網上的數字一旦可以編，這整頁關於
// 「信號可靠度分層」的主張就自己打了自己。
const CLIP = {
  model: 'ollama:qwen2.5:14b',
  stored: 6.78,
  dims: [
    { k: 'hook',      label: '開場鉤子', value: 6.5, w: 30 },
    { k: 'visual',    label: '視覺敘事', value: 7.0, w: 25 },
    { k: 'pacing',    label: '節奏',     value: 6.0, w: 20 },
    { k: 'structure', label: '結構',     value: 7.5, w: 25 },
  ],
};
const boot = JSON.stringify({
  dims: Object.fromEntries(CLIP.dims.map((d) => [d.k, d.value])),
  defaults: Object.fromEntries(CLIP.dims.map((d) => [d.k, d.w])),
  stored: CLIP.stored,
});
---
<figure class="scorecard" data-boot={boot} aria-label="工藝評分與重新加權（可操作）">
  <figcaption class="sc-head">
    <span class="lbl">工藝評分</span>
    <span class="sc-model mono">參考，非定論 · {CLIP.model}</span>
  </figcaption>

  <div class="sc-row sc-overall" style={`--v:${CLIP.stored}`}>
    <span class="sc-k">總分</span>
    <span class="sc-bar"><i id="sc-obar"></i></span>
    <span class="sc-v mono" id="sc-oval" aria-live="polite">{CLIP.stored.toFixed(1)}</span>
  </div>

  {CLIP.dims.map((d, i) => (
    <div class="sc-row" style={`--v:${d.value}; --i:${i + 1}`}>
      <span class="sc-k">{d.label}</span>
      <span class="sc-bar"><i></i></span>
      <span class="sc-v mono">{d.value.toFixed(1)}</span>
    </div>
  ))}

  <div class="sc-weights">
    <p class="sc-invite"><span class="sc-grip" aria-hidden="true">↔</span>
      <strong>這四條可以拖</strong>——試試把「節奏」拉到底，看總分怎麼變。</p>
    <p class="sc-wnote">
      四個維度來自模型，<strong>拖了也不會變</strong>；變的只是它們怎麼組合。
      權重會自動縮放成總和 100%，所以結果仍在同一把 0–10 的尺上。
    </p>
    {CLIP.dims.map((d) => (
      <div class="wrow">
        <label for={`w-${d.k}`}>{d.label}</label>
        <input type="range" id={`w-${d.k}`} data-dim={d.k}
               min="0" max="100" step="1" value={d.w}
               aria-label={`${d.label}的權重`} />
        <span class="wval mono" id={`wv-${d.k}`}>{d.w}%</span>
      </div>
    ))}
    <div class="wfoot">
      <span class="wdelta mono" id="sc-delta" aria-live="polite"></span>
      <button type="button" id="sc-reset" class="wbtn">重設為預設</button>
    </div>
  </div>
</figure>

<script is:inline>
(function () {
  var card = document.querySelector('.scorecard');
  if (!card) return;
  var boot = JSON.parse(card.dataset.boot);
  var sliders = [].slice.call(card.querySelectorAll('.wrow input[type=range]'));
  var obar = document.getElementById('sc-obar');
  var oval = document.getElementById('sc-oval');
  var delta = document.getElementById('sc-delta');

  // 逐行照 inspector.py 的 computeOverall —— 夾負值、縮放到總和 1、四捨五入 2dp。
  function computeOverall(w) {
    var total = 0, d;
    for (d in w) if (w.hasOwnProperty(d)) total += Math.max(0, w[d]);
    if (total <= 0) return null;
    var sum = 0;
    for (d in boot.dims) {
      if (!boot.dims.hasOwnProperty(d)) continue;
      var wd = (w[d] == null) ? 0 : Math.max(0, w[d]);
      sum += (+boot.dims[d]) * (wd / total);
    }
    return Math.round(sum * 100) / 100;
  }
  function currentWeights() {
    var w = {};
    sliders.forEach(function (s) { w[s.dataset.dim] = +s.value; });
    return w;
  }
  function isDefault() {
    return sliders.every(function (s) { return boot.defaults[s.dataset.dim] === +s.value; });
  }
  function apply() {
    var w = currentWeights();
    sliders.forEach(function (s) {
      var l = document.getElementById('wv-' + s.dataset.dim);
      if (l) l.textContent = s.value + '%';
    });
    var v = computeOverall(w);
    if (v == null) {
      // 全部拖到 0 ＝ 沒有任何維度被重視，那不是 0 分，是「算不出來」。
      oval.textContent = '—';
      obar.style.width = '0%';
      delta.textContent = '權重全為 0，算不出總分';
      return;
    }
    oval.textContent = v.toFixed(1);
    obar.style.width = Math.max(0, Math.min(100, v * 10)) + '%';
    var diff = Math.round((v - boot.stored) * 100) / 100;
    delta.textContent = isDefault()
      ? '預設權重 · 與儲存的分數相同'
      : (diff === 0 ? '與儲存的分數相同'
                    : '比儲存的分數 ' + (diff > 0 ? '+' : '') + diff.toFixed(2));
  }
  sliders.forEach(function (s) { s.addEventListener('input', apply); });
  document.getElementById('sc-reset').addEventListener('click', function () {
    sliders.forEach(function (s) { s.value = boot.defaults[s.dataset.dim]; });
    apply();
  });

  // ── 自動示範 ───────────────────────────────────────────────────────────
  // 🔴 為什麼需要：這個面板**看起來就是一張靜態圖**。滑桿的軌道跟上面的評分長條
  //    長得太像，讀者會把它讀成「又一排數據」而不是控制項 —— 實際回饋。
  //    所以進場時自己動一次：把「節奏」拉上去再放回來，總分跟著走一趟。
  //    示範比任何一句「可以拖」都快。
  //
  // 三條規矩：
  //   ① 只跑一次（跑完就不再自己動，否則會變成跑馬燈）
  //   ② 使用者一碰就立刻停 —— 不跟使用者搶控制權
  //   ③ prefers-reduced-motion 時不跑，改成靜態提示
  var userTouched = false;
  function stopDemo() {
    userTouched = true;
    // 🔴 高亮也要收掉。tween 在 userTouched 時提前 return，收尾的 callback
    //    就永遠不會跑 —— 不在這裡清，那一列會一直粗體卡著（實測撞到）。
    card.classList.remove('is-demo');
  }
  ['pointerdown', 'keydown', 'wheel'].forEach(function (ev) {
    card.addEventListener(ev, stopDemo, { once: true, passive: true });
  });

  function tween(slider, from, to, ms, done) {
    var t0 = null;
    function step(ts) {
      if (userTouched) { return; }
      if (t0 === null) t0 = ts;
      var k = Math.min(1, (ts - t0) / ms);
      // easeInOutCubic —— 等速移動看起來像程式在跑，不像有人在拖
      var e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
      slider.value = String(Math.round(from + (to - from) * e));
      slider.dispatchEvent(new Event('input', { bubbles: true }));
      if (k < 1) requestAnimationFrame(step); else if (done) setTimeout(done, 0);
    }
    requestAnimationFrame(step);
  }

  function demo() {
    var s = card.querySelector('input[data-dim="pacing"]');
    if (!s || userTouched) return;
    var home = +s.value;
    card.classList.add('is-demo');
    tween(s, home, 85, 900, function () {
      setTimeout(function () {
        tween(s, 85, home, 700, function () { card.classList.remove('is-demo'); });
      }, 850);
    });
  }

  // 進場動畫：進入視窗才跑、只跑一次。
  // 🔴 prefers-reduced-motion 時直接到最終值 —— 那不是偏好設定，
  //    對前庭失調的人是症狀開關。關掉時不是「比較快的動畫」。
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function arrive(withDemo) {
    card.classList.add('is-in');
    apply();
    // 等長條跑完（900ms + 最後一條的 delay）再示範，不然兩段動畫疊在一起看不懂
    if (withDemo) setTimeout(demo, 1350);
  }
  if (reduce || !('IntersectionObserver' in window)) { arrive(false); return; }
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { arrive(true); io.unobserve(e.target); } });
  }, { threshold: 0.3 });
  io.observe(card);
})();
</script>
