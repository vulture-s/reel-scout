# Reel Scout — Environment Configuration
# Copy to .env and fill in values

# --- Paths ---
# REEL_SCOUT_DATA=./data

# --- VLM ---
# VLM_BACKEND=omlx
# VLM_MODEL=
# OMLX_BASE_URL=http://localhost:8000/v1
# OLLAMA_BASE_URL=http://localhost:11434

# --- LLM ---
# LLM_BACKEND=omlx
# LLM_MODEL=
# Simplified->Traditional at the source (needs the zh extra): inspire's analysis copy,
# and Simplified transcripts/subtitles on save (original kept in transcripts.*_original)
# REEL_SCOUT_ZH_CONVERT=s2twp        # s2twp | s2tw | off
# REEL_SCOUT_ZH_HOTWORDS=            # YAML/JSON source: replacement table, see docs/zh-hotwords.example.yaml
# INSPIRE_NAME_RETRIES=2             # re-asks on a real-name miss (0 = check only)
# OPENCLAW_BASE_URL=http://localhost:18789/v1
# OPENCLAW_MODEL=

# --- Whisper ---
# WHISPER_BACKEND=faster-whisper   # or whisper-cpp / mlx
#   mlx = mlx-whisper on Metal (Apple Silicon, `pip install "reel-scout[mlx]"`).
#   Opt-in; with it set WHISPER_MODEL=large-v3-turbo (or an HF repo id). Falls back
#   to faster-whisper with a one-line notice when mlx is unavailable.
# WHISPER_MODEL=large-v3
# Language handling (defaults reproduce prior behavior: auto-detect once, transcribe):
#   WHISPER_LANGUAGE=      # "" = auto-detect; or force e.g. "en" / "zh"
#   WHISPER_TASK=transcribe  # or "translate" to force English output
# Bilingual / code-switching audio (中英對照訪談): whisper large-v3 drifts on long
# files — once it locks onto the opening language it "translates" later speech of the
# OTHER language into the locked one (garbled output). Fix = per-chunk re-detection:
#   WHISPER_MULTILINGUAL=1
#   WHISPER_CHUNK_LENGTH=15
# Verified on a 40-min ZH-host/EN-guest interview: latin-char recovery 56%->90%.
# Leave OFF for single-language short-form (multilingual adds per-chunk detect cost).
# WHISPER_MULTILINGUAL=false
# WHISPER_CHUNK_LENGTH=0

# --- Crawl ---
# IG_COOKIES_FILE=
# RATE_LIMIT_PER_MINUTE=10

# --- Vision ---
# KEYFRAME_STRATEGY=scene
# KEYFRAME_MAX=8

# --- External tools ---
# FFMPEG_BIN=ffmpeg

# --- Speaker Diarization ---
DIARIZE_ENABLED=false
# PYANNOTE_AUTH_TOKEN=  # HuggingFace token (required for pyannote)

# --- Optional ---
# WEBHOOK_URL=
